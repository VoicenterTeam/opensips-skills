{
  "name": "opensips-skills",
  "version": "0.1.0",
  "description": "Claude Code plugin: three coordinated Agent Skills for working with OpenSIPs",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"console.error('Not yet implemented'); process.exit(1)\"",
    "validate": "tsx scripts/build-references.ts --validate-only",
    "clean": "node -e \"console.error('Not yet implemented'); process.exit(1)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:golden": "vitest run tests/golden",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint scripts/",
    "format": "prettier --write \"scripts/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"scripts/**/*.{ts,js,json}\" \"*.{json,md}\"",
    "schemas:hash": "tsx scripts/schemas/regenerate-hash.ts",
    "baseline:update": "node -e \"console.error('Not yet implemented'); process.exit(1)\""
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^50.8.0",
    "memfs": "^4.57.2",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "zod-validation-error": "^3.5.4"
  }
}
